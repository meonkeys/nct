{
    "name": "nct/nct",
    "description": "Send and receive your phone's SMS from Nextcloud",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.5",
        "capcom6/android-sms-gateway": "^2.6",
        "guzzlehttp/guzzle": "^7.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "nextcloud/coding-standard": "^1.5",
        "christophwurst/nextcloud_testing": "^3.0",
        "psalm/phar": "^7.10",
        "nextcloud/ocp": "^35.0",
        "symfony/console": "^6.4"
    },
    "config": {
        "vendor-dir": "composer"
    },
    "autoload": {
        "psr-4": {
            "OCA\\Nct\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Nct\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "lint:lint": "find . -name '*.php' -not -path './composer/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l",
        "psalm": "psalm.phar --threads=1 --no-diff",
        "psalm:quick": "psalm.phar",
        "psalm:update-baseline": "psalm.phar --threads=1 --no-diff --update-baseline"
    }
}
